{
  "name": "@simsys/tokens",
  "version": "0.1.0",
  "description": "Drop-in API-token store, auth and management surface for Express apps. sha256-at-rest; operator-gated CRUD; no dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simmons-Systems/simsys-tokens.git",
    "directory": "node"
  },
  "keywords": [
    "tokens",
    "authentication",
    "express",
    "api-tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    }
  },
  "bin": {
    "simsys-tokens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tests.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^6.0.0",
    "express": "^5.0.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
